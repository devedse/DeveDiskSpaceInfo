<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Trimming settings -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Uncommenting this will show all trim warnings: -->
    <!-- <TrimmerSingleWarn>false</TrimmerSingleWarn> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <!-- Devedse.DiscUtils: the DiscUtils fork with NTFS journal support (LTRData/DiscUtils#97), published until LTRData releases it. -->
    <PackageReference Include="Devedse.DiscUtils.FileSystems" Version="1.0.111" />
    <PackageReference Include="Devedse.DiscUtils.Ntfs" Version="1.0.111" />
    <PackageReference Include="SimpleExec" Version="13.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeveDiskSpaceInfo.Tests" />
  </ItemGroup>

  <!-- Reference Linker.xml to preserve assemblies from trimming -->
  <ItemGroup>
    <!-- Ideally the DiscUtils package follows this tutorial which should not require the Linker.xml anymore then: https://learn.microsoft.com/en-us/dotnet/core/deploying/trimming/prepare-libraries-for-trimming -->
    <TrimmerRootDescriptor Include="Linker.xml" />
  </ItemGroup>

</Project>
